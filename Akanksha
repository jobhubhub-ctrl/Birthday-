<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>A Special Surprise For Akansha ❤️</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;800&family=Great+Vibes&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --rose-primary: #e63946;
      --rose-dark: #590d22;
      --gold-grad: linear-gradient(135deg, #ffe599 0%, #ffc107 50%, #d48806 100%);
      --rose-grad: linear-gradient(135deg, #ff4d6d 0%, #c9184a 50%, #800f2f 100%);
      --card-bg: rgba(255, 245, 247, 0.92);
      --card-border: rgba(255, 182, 193, 0.65);
      --text-main: #3d0c1e;
      --text-muted: #703348;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Poppins', sans-serif;
      color: var(--text-main);
      overflow-x: hidden;
      min-height: 100vh;
      position: relative;
      background: #140207;
    }

    /* ROSE GARDEN BACKGROUND (38% BLUR) */
    .rose-garden-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background-image: linear-gradient(rgba(20, 2, 7, 0.60), rgba(50, 4, 18, 0.70)), 
                        url('https://images.unsplash.com/photo-1559563458-527698bf5295?q=80&w=1920&auto=format&fit=crop');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      filter: blur(7.6px);
      transform: scale(1.05);
      z-index: 0;
      pointer-events: none;
    }

    /* FLOATING SHAPES */
    .bg-decorations {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 1;
      overflow: hidden;
    }

    .floating-shape {
      position: absolute;
      bottom: -80px;
      font-size: 22px;
      animation: floatUpSlow 12s linear infinite;
      opacity: 0.6;
      filter: drop-shadow(0 0 10px rgba(255, 77, 109, 0.8));
    }

    @keyframes floatUpSlow {
      0% { transform: translateY(0) rotate(0deg) scale(0.8); opacity: 0; }
      20% { opacity: 0.8; }
      80% { opacity: 0.8; }
      100% { transform: translateY(-125vh) rotate(360deg) scale(1.2); opacity: 0; }
    }

    /* GIFT UNBOXING SCREEN */
    #gift-screen {
      width: 100%;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      position: relative;
      padding: 40px 20px;
      text-align: center;
      z-index: 100;
      background: radial-gradient(circle at center, rgba(74, 10, 28, 0.88) 0%, rgba(18, 2, 8, 0.96) 100%);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      transition: opacity 1s cubic-bezier(0.4, 0, 0.2, 1), transform 1s ease;
    }

    .gift-title {
      font-family: 'Great Vibes', cursive;
      color: #fff;
      font-size: 3.8rem;
      margin-bottom: 12px;
      text-shadow: 0 0 20px rgba(255, 77, 109, 0.9), 0 0 40px rgba(201, 24, 74, 0.8);
      line-height: 1.2;
    }

    .gift-title .heart {
      color: #ff3366;
      display: inline-block;
      animation: heartBeat 1.3s infinite;
      filter: drop-shadow(0 0 12px #ff3366);
    }

    @keyframes heartBeat {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.28); }
    }

    .countdown-container-p1 {
      margin: 15px 0 25px;
      background: rgba(255, 255, 255, 0.12);
      border: 1.5px solid rgba(255, 215, 0, 0.45);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      padding: 16px 28px;
      border-radius: 25px;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
    }

    .countdown-title-p1 {
      color: #ffe599;
      font-size: 0.9rem;
      letter-spacing: 3px;
      font-weight: 700;
      margin-bottom: 12px;
      text-transform: uppercase;
      font-family: 'Cinzel', serif;
    }

    .countdown-grid {
      display: flex;
      justify-content: center;
      gap: 14px;
    }

    .time-box {
      background: rgba(255, 255, 255, 0.95);
      border: 1.5px solid #ffccd5;
      border-radius: 14px;
      padding: 10px 14px;
      min-width: 65px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.3);
    }

    .time-val {
      font-size: 1.5rem;
      font-weight: 800;
      color: #c9184a;
      line-height: 1;
    }

    .time-label {
      font-size: 0.65rem;
      color: #590d22;
      text-transform: uppercase;
      font-weight: 700;
      margin-top: 4px;
    }

    /* 3D GIFT BOX */
    .gift-box-wrapper {
      position: relative;
      width: 220px;
      height: 220px;
      margin: 20px auto 10px;
      cursor: pointer;
      perspective: 1000px;
    }

    .gift-glow {
      position: absolute;
      top: -25px;
      left: -25px;
      width: 270px;
      height: 270px;
      background: radial-gradient(circle, rgba(255, 77, 109, 0.55) 0%, rgba(255, 215, 0, 0.35) 40%, rgba(0, 0, 0, 0) 70%);
      border-radius: 50%;
      animation: pulseGlow 2.2s infinite ease-in-out;
    }

    @keyframes pulseGlow {
      0%, 100% { transform: scale(0.95); opacity: 0.7; }
      50% { transform: scale(1.2); opacity: 1; }
    }

    .gift-box-3d {
      width: 100%;
      height: 100%;
      position: relative;
      transform-style: preserve-3d;
      animation: floatBox 3.5s infinite ease-in-out;
    }

    @keyframes floatBox {
      0%, 100% { transform: translateY(0) rotateY(0deg); }
      50% { transform: translateY(-14px) rotateY(10deg); }
    }

    .gift-body {
      position: absolute;
      width: 180px;
      height: 140px;
      bottom: 0;
      left: 20px;
      background: linear-gradient(135deg, #ffffff 0%, #fff0f3 100%);
      border-radius: 12px;
      box-shadow: 0 20px 45px rgba(0,0,0,0.6);
      border: 2px solid #ffccd5;
      overflow: hidden;
    }

    .gift-ribbon-v {
      position: absolute;
      width: 36px;
      height: 100%;
      left: 50%;
      transform: translateX(-50%);
      background: var(--gold-grad);
      box-shadow: 0 0 10px rgba(255, 215, 0, 0.4);
    }

    .gift-lid {
      position: absolute;
      width: 200px;
      height: 48px;
      top: 24px;
      left: 10px;
      background: linear-gradient(135deg, #ffffff 0%, #ffe5ec 100%);
      border-radius: 10px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.45);
      border: 2px solid #ffccd5;
      z-index: 5;
      transition: transform 1.2s cubic-bezier(0.6, -0.28, 0.735, 0.045), opacity 0.8s;
      transform-origin: top left;
    }

    .gift-lid-ribbon {
      position: absolute;
      width: 36px;
      height: 100%;
      left: 50%;
      transform: translateX(-50%);
      background: var(--gold-grad);
    }

    .gift-bow {
      position: absolute;
      top: -30px;
      left: 50%;
      transform: translateX(-50%);
      width: 90px;
      height: 45px;
      z-index: 6;
      transition: transform 1s ease, opacity 0.8s;
    }

    .bow-loop-left, .bow-loop-right {
      position: absolute;
      width: 44px;
      height: 36px;
      border-radius: 50% 50% 0 50%;
      background: var(--gold-grad);
      border: 1px solid #e6a100;
      box-shadow: 0 4px 10px rgba(0,0,0,0.25);
    }

    .bow-loop-left { left: 2px; transform: rotate(-22deg); }
    .bow-loop-right { right: 2px; transform: scaleX(-1) rotate(-22deg); }

    .gift-open .gift-lid {
      transform: translateY(-160px) rotate(-45deg) scale(0.6);
      opacity: 0;
    }

    .gift-open .gift-bow {
      transform: translateY(-200px) scale(0.4);
      opacity: 0;
    }

    .gift-open .gift-body {
      animation: bodyUnfold 0.9s forwards ease-in-out;
    }

    @keyframes bodyUnfold {
      0% { transform: scale(1); }
      40% { transform: scale(1.15) rotate(3deg); }
      100% { transform: scale(0); opacity: 0; }
    }

    .tap-btn {
      margin-top: 25px;
      background: var(--rose-grad);
      color: #ffffff;
      font-weight: 700;
      font-size: 1.1rem;
      padding: 15px 42px;
      border-radius: 50px;
      box-shadow: 0 0 30px rgba(255, 77, 109, 0.8), inset 0 2px 4px rgba(255, 255, 255, 0.4);
      border: 2px solid #ffe5ec;
      cursor: pointer;
      animation: bounceBtn 2.2s infinite;
      z-index: 10;
      letter-spacing: 0.5px;
      transition: all 0.3s ease;
    }

    .tap-btn:hover {
      transform: scale(1.05);
      box-shadow: 0 0 40px rgba(255, 77, 109, 1);
    }

    @keyframes bounceBtn {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }

    /* MAIN ROMANTIC DASHBOARD */
    #main-website {
      display: none;
      position: relative;
      z-index: 2;
      padding: 50px 16px 70px;
      min-height: 100vh;
      opacity: 0;
      transition: opacity 1.2s ease;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
    }

    .main-header {
      text-align: center;
      margin-bottom: 35px;
    }

    .main-header .sub-badge {
      display: inline-block;
      padding: 6px 20px;
      background: rgba(255, 255, 255, 0.18);
      border: 1.5px solid rgba(255, 215, 0, 0.5);
      border-radius: 30px;
      color: #ffe599;
      font-size: 0.82rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 12px;
      backdrop-filter: blur(10px);
    }

    .main-header h1 {
      font-family: 'Cinzel', serif;
      font-size: 2.3rem;
      color: #fff;
      letter-spacing: 1px;
      line-height: 1.3;
      text-shadow: 0 4px 18px rgba(0,0,0,0.7), 0 0 25px rgba(255, 77, 109, 0.7);
    }

    .main-header h1 span {
      font-family: 'Great Vibes', cursive;
      color: #ffb3c1;
      font-size: 3.4rem;
      display: inline-block;
      text-shadow: 0 0 30px rgba(255, 77, 109, 0.9);
    }

    /* LIFE LINES HIGHLIGHT BANNER */
    .lifelines-banner {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(255, 240, 245, 0.92));
      border: 2px solid #ffb3c1;
      border-radius: 20px;
      padding: 20px 24px;
      margin-bottom: 25px;
      text-align: center;
      box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .lifeline-quote {
      font-family: 'Great Vibes', cursive;
      font-size: 2rem;
      color: #c9184a;
      line-height: 1.3;
      margin-bottom: 6px;
    }

    .lifeline-subtext {
      font-size: 0.88rem;
      color: #590d22;
      font-weight: 500;
      line-height: 1.6;
    }

    .grid-3 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
      margin-bottom: 24px;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 22px;
      margin-bottom: 24px;
    }

    .card {
      background: var(--card-bg);
      border: 1.5px solid var(--card-border);
      border-radius: 24px;
      padding: 24px 20px;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4), 0 0 20px rgba(255, 77, 109, 0.2);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      text-align: center;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.5), 0 0 30px rgba(255, 77, 109, 0.35);
    }

    .card-title {
      font-size: 0.9rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      color: #590d22;
      text-transform: uppercase;
      margin-bottom: 18px;
      font-family: 'Cinzel', serif;
      position: relative;
      display: inline-block;
    }

    .card-title::after {
      content: '';
      position: absolute;
      bottom: -6px;
      left: 15%;
      right: 15%;
      height: 2px;
      background: var(--rose-grad);
      border-radius: 2px;
    }

    /* PHOTO FRAME: FIT-TO-FRAME & CLEAN */
    .photo-card-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .photo-frame {
      position: relative;
      width: 175px;
      height: 215px;
      margin: 0 auto 14px;
      padding: 6px;
      background: linear-gradient(135deg, #fff 0%, #fff0f3 100%);
      border-radius: 20px;
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3), 0 0 15px rgba(255, 77, 109, 0.4);
      cursor: pointer;
      transition: transform 0.3s ease;
    }

    .photo-frame::before {
      content: '';
      position: absolute;
      top: -3px; left: -3px; right: -3px; bottom: -3px;
      background: linear-gradient(135deg, #ffe599, #ff4d6d, #c9184a);
      border-radius: 22px;
      z-index: -1;
    }

    .photo-frame:hover {
      transform: scale(1.04);
    }

    .photo-inner {
      width: 100%;
      height: 100%;
      border-radius: 14px;
      overflow: hidden;
      background: #000;
      position: relative;
    }

    .photo-frame img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      display: block;
      image-rendering: -webkit-optimize-contrast;
      image-rendering: crisp-edges;
      transition: transform 0.5s ease;
    }

    .btn-gold {
      background: var(--rose-grad);
      color: #fff;
      border: none;
      padding: 10px 24px;
      font-size: 0.85rem;
      font-weight: 600;
      border-radius: 25px;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(201, 24, 74, 0.4);
      transition: all 0.3s ease;
      letter-spacing: 0.5px;
    }

    .btn-gold:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(201, 24, 74, 0.6);
      background: linear-gradient(135deg, #ff4d6d 0%, #800f2f 100%);
    }

    /* OUR JOURNEY TIMELINE */
    .timeline-container {
      position: relative;
      padding-left: 20px;
      text-align: left;
      margin-top: 10px;
    }

    .timeline-container::before {
      content: '';
      position: absolute;
      left: 4px;
      top: 5px;
      bottom: 5px;
      width: 2px;
      background: linear-gradient(180deg, #ff4d6d, #ffccd5);
    }

    .timeline-node {
      position: relative;
      margin-bottom: 16px;
      padding-left: 15px;
    }

    .timeline-node::before {
      content: '❤️';
      position: absolute;
      left: -19px;
      top: 0;
      font-size: 0.8rem;
    }

    .timeline-node h4 {
      font-size: 0.85rem;
      color: #c9184a;
      font-weight: 700;
      margin-bottom: 2px;
    }

    .timeline-node p {
      font-size: 0.78rem;
      color: #590d22;
      line-height: 1.5;
    }

    .coupon-item {
      background: #fff8fa;
      border: 2px dashed #ff758f;
      border-radius: 16px;
      padding: 14px 12px;
      margin-bottom: 12px;
      font-size: 0.82rem;
      font-weight: 700;
      color: #590d22;
      cursor: pointer;
      transition: all 0.25s ease;
      box-shadow: 0 4px 10px rgba(0,0,0,0.04);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .coupon-item:hover {
      transform: translateY(-3px) scale(1.02);
      background: #ffe5ec;
      border-color: #c9184a;
      box-shadow: 0 6px 15px rgba(201, 24, 74, 0.2);
    }

    .music-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: #fff8fa;
      border-radius: 18px;
      padding: 14px 18px;
      border: 1.5px solid #ffccd5;
    }

    .play-btn {
      width: 48px;
      height: 48px;
      background: var(--rose-grad);
      border-radius: 50%;
      display: flex;
      justify-content: center;
      align-items: center;
      color: #fff;
      cursor: pointer;
      font-size: 1.2rem;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      box-shadow: 0 4px 12px rgba(201, 24, 74, 0.4);
    }

    .play-btn:active {
      transform: scale(0.92);
    }

    /* SECRET LOVE NOTE (LOCAL STORAGE) */
    .note-card {
      margin-top: 10px;
      text-align: left;
    }

    .note-textarea {
      width: 100%;
      height: 110px;
      padding: 14px;
      border-radius: 16px;
      border: 1.5px solid #ffccd5;
      background: #fff;
      font-family: 'Poppins', sans-serif;
      font-size: 0.88rem;
      color: #590d22;
      resize: none;
      outline: none;
      transition: border 0.3s ease, box-shadow 0.3s ease;
      margin-bottom: 12px;
    }

    .note-textarea:focus {
      border-color: #c9184a;
      box-shadow: 0 0 12px rgba(201, 24, 74, 0.25);
    }

    .note-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    .saved-msg-banner {
      background: #fff0f3;
      border-left: 4px solid #c9184a;
      padding: 12px 14px;
      border-radius: 8px;
      margin-top: 14px;
      font-size: 0.85rem;
      color: #590d22;
      line-height: 1.6;
      display: none;
    }

    /* POPUPS */
    .popup-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(20, 2, 8, 0.85);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 1000;
      padding: 20px;
    }

    .popup-content {
      background: #ffffff;
      padding: 30px 25px;
      border-radius: 25px;
      max-width: 480px;
      width: 100%;
      text-align: center;
      border: 2px solid #ffccd5;
      box-shadow: 0 20px 45px rgba(0,0,0,0.5), 0 0 30px rgba(255, 77, 109, 0.3);
      animation: popIn 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      max-height: 85vh;
      overflow-y: auto;
    }

    .photo-modal-content {
      background: transparent;
      box-shadow: none;
      border: none;
      max-width: 500px;
      padding: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .photo-modal-img {
      width: 100%;
      max-height: 72vh;
      object-fit: contain;
      border-radius: 20px;
      border: 4px solid #fff;
      box-shadow: 0 20px 45px rgba(0,0,0,0.8), 0 0 25px rgba(255, 77, 109, 0.5);
    }

    @keyframes popIn {
      0% { transform: scale(0.65); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }

    .particle {
      position: fixed;
      pointer-events: none;
      z-index: 10000;
      animation: floatUp 4s linear forwards;
    }

    @keyframes floatUp {
      0% { transform: translateY(100vh) scale(0.4) rotate(0deg); opacity: 1; }
      100% { transform: translateY(-10vh) scale(1.4) rotate(360deg); opacity: 0; }
    }

    @media (max-width: 600px) {
      .gift-title { font-size: 2.8rem; }
      .main-header h1 { font-size: 1.7rem; }
      .main-header h1 span { font-size: 2.4rem; }
      .photo-frame { width: 155px; height: 195px; }
      .card { padding: 20px 15px; }
      .lifeline-quote { font-size: 1.6rem; }
    }
  </style>
</head>
<body>

  <!-- ROSE GARDEN BACKGROUND (38% BLURRED) -->
  <div class="rose-garden-bg"></div>

  <!-- ROMANTIC SONG STREAM -->
  <audio id="bgSong" loop preload="auto">
    <source src="https://cdn.pixabay.com/download/audio/2022/10/14/audio_9939f792cb.mp3?filename=love-ambient-piano-123847.mp3" type="audio/mpeg">
  </audio>

  <!-- FLOATING HEARTS & PARTICLES -->
  <div class="bg-decorations" id="bgDecor"></div>

  <!-- GIFT UNBOXING SCREEN -->
  <div id="gift-screen">
    <div class="gift-title">A Special Surprise<br>For Akansha <span class="heart">❤️</span></div>

    <div class="countdown-container-p1">
      <div class="countdown-title-p1">🌹 Birthday Countdown 🌹</div>
      <div class="countdown-grid">
        <div class="time-box">
          <div class="time-val" id="days">00</div>
          <div class="time-label">Days</div>
        </div>
        <div class="time-box">
          <div class="time-val" id="hours">00</div>
          <div class="time-label">Hours</div>
        </div>
        <div class="time-box">
          <div class="time-val" id="mins">00</div>
          <div class="time-label">Mins</div>
        </div>
        <div class="time-box">
          <div class="time-val" id="secs">00</div>
          <div class="time-label">Secs</div>
        </div>
      </div>
    </div>

    <div class="gift-box-wrapper" id="giftBoxWrapper" onclick="openSurprise()">
      <div class="gift-glow"></div>
      <div class="gift-box-3d" id="gift3D">
        <div class="gift-bow">
          <div class="bow-loop-left"></div>
          <div class="bow-loop-right"></div>
