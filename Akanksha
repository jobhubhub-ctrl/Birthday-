    // PARTICLES (HEARTS & ROSES)
    function createHeart() {
      const symbols = ['💖', '✨', '❤️', '🌸', '💕', '🌹', '⭐', '💍'];
      const p = document.createElement('div');
      p.classList.add('particle');
      p.innerText = symbols[Math.floor(Math.random() * symbols.length)];
      p.style.left = Math.random() * 100 + 'vw';
      p.style.fontSize = (Math.random() * 18 + 16) + 'px';
      p.style.animationDuration = (Math.random() * 2 + 3) + 's';
      document.body.appendChild(p);

      setTimeout(() => { p.remove(); }, 4000);
    }

    // CONTINUOUS FLOATING ROMANTIC SHAPES
    const bgDecor = document.getElementById('bgDecor');
    const shapeList = ['❤️', '🌸', '✨', '🌹', '💕'];
    for (let i = 0; i < 18; i++) {
      let b = document.createElement('div');
      b.classList.add('floating-shape');
      b.innerText = shapeList[Math.floor(Math.random() * shapeList.length)];
      b.style.left = Math.random() * 100 + 'vw';
      b.style.animationDelay = (Math.random() * 10) + 's';
      b.style.animationDuration = (Math.random() * 6 + 8) + 's';
      bgDecor.appendChild(b);
    }

    // COUNTDOWN TIMER
    const targetDate = new Date("September 10, 2026 00:00:00").getTime();
    const countdownTimer = setInterval(() => {
      const now = new Date().getTime();
      const diff = targetDate - now;

      if (diff > 0) {
        document.getElementById('days').innerText = String(Math.floor(diff / (1000 * 60 * 60 * 24))).padStart(2, '0');
        document.getElementById('hours').innerText = String(Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60))).padStart(2, '0');
        document.getElementById('mins').innerText = String(Math.floor((diff % (1000 * 60)) / (1000 * 60))).padStart(2, '0');
        document.getElementById('secs').innerText = String(Math.floor((diff % (1000 * 60)) / 1000)).padStart(2, '0');
      } else {
        clearInterval(countdownTimer);
        document.querySelector('.countdown-container-p1').innerHTML = 
          '<div style="color:#ffe599; font-size:1.15rem; font-weight:700; padding:10px;">🎉 IT\'S YOUR SPECIAL DAY! HAPPY BIRTHDAY AKANSHA! 🎂❤️</div>';
      }
    }, 1000);
