  <script>
    const song = document.getElementById('bgSong');
    const musicToggle = document.getElementById('musicToggle');
    let audioCtx = null;
    let synthInterval = null;

    // LOCAL STORAGE HANDLERS
    function loadSavedNote() {
      const savedNote = localStorage.getItem('akansha_love_note');
      const noteBox = document.getElementById('akanshaLoveNote');
      const displayBanner = document.getElementById('savedNoteDisplay');
      const displayText = document.getElementById('savedNoteText');

      if (savedNote && savedNote.trim() !== '') {
        noteBox.value = savedNote;
        displayText.innerText = `"${savedNote}"`;
        displayBanner.style.display = 'block';
      } else {
        displayBanner.style.display = 'none';
      }
    }

    function saveLoveNote() {
      const noteBox = document.getElementById('akanshaLoveNote');
      const noteVal = noteBox.value.trim();

      if (!noteVal) {
        showPopup('Note Empty 💕', 'Please write a sweet message before saving!');
        return;
      }

      localStorage.setItem('akansha_love_note', noteVal);
      loadSavedNote();
      showPopup('Message Saved! 💖', 'Aapka pyara message permanently save ho gaya hai! Jab bhi aap ya wo page kholenge, ye message yahan rahega. ✨');
    }

    function clearLoveNote() {
      if (confirm('Kya aap is note ko delete karna chahte hain?')) {
        localStorage.removeItem('akansha_love_note');
        document.getElementById('akanshaLoveNote').value = '';
        document.getElementById('savedNoteDisplay').style.display = 'none';
      }
    }

    window.addEventListener('DOMContentLoaded', loadSavedNote);

    function playRomanticTone() {
      song.play().then(() => {
        musicToggle.innerText = '⏸';
      }).catch(() => {
        startSynthMelody();
      });
    }

    function startSynthMelody() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }

      const chords = [
        [261.63, 329.63, 392.00],
        [220.00, 261.63, 329.63],
        [174.61, 220.00, 261.63],
        [196.00, 246.94, 293.66]
      ];

      let chordIdx = 0;
      musicToggle.innerText = '⏸';

      function playChord() {
        if (!audioCtx) return;
        chords[chordIdx].forEach((freq) => {
          let osc = audioCtx.createOscillator();
          let gain = audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
          gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 1.8);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start();
          osc.stop(audioCtx.currentTime + 1.8);
        });
        chordIdx = (chordIdx + 1) % chords.length;
      }

      clearInterval(synthInterval);
      synthInterval = setInterval(playChord, 1200);
    }

    function toggleMusic() {
      if (!song.paused) {
        song.pause();
        musicToggle.innerText = '▶';
      } else if (synthInterval) {
        clearInterval(synthInterval);
        synthInterval = null;
        musicToggle.innerText = '▶';
      } else {
        playRomanticTone();
      }
    }

    // OPEN SURPRISE
    function openSurprise() {
      const box = document.getElementById('giftBoxWrapper');
      const giftScreen = document.getElementById('gift-screen');
      const mainWebsite = document.getElementById('main-website');

      box.classList.add('gift-open');
      playRomanticTone();

      for (let i = 0; i < 60; i++) {
        setTimeout(createHeart, i * 15);
      }

      setTimeout(() => {
        giftScreen.style.opacity = '0';
        giftScreen.style.transform = 'scale(0.9)';
        
        setTimeout(() => {
          giftScreen.style.display = 'none';
          mainWebsite.style.display = 'block';
          setTimeout(() => {
            mainWebsite.style.opacity = '1';
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }, 50);
        }, 800);
      }, 700);
    }

    // POPUP CONTROLS
    function showPopup(title, content) {
      document.getElementById('popupTitle').innerHTML = title;
      document.getElementById('popupText').innerHTML = content;
      document.getElementById('popupOverlay').style.display = 'flex';
